{
    "name": "portf",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node scripts/build.mjs",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test:dreams": "node --experimental-strip-types --test tests/dreams.test.mjs",
        "test:dreams:browser": "playwright test",
        "lint:dreams": "eslint --no-eslintrc --config .eslintrc.dreams.cjs src/dreams src/App.jsx scripts tests playwright.config.js --ext js,jsx,mjs --max-warnings 0",
        "build:pages-root": "node scripts/sync-pages-root.mjs"
    },
    "dependencies": {
        "@use-gesture/react": "^10.3.1",
        "framer-motion": "^12.23.26",
        "gsap": "^3.12.5",
        "lenis": "^1.3.25",
        "lucide-react": "^0.344.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.22.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "vite": "^5.2.0"
    }
}
